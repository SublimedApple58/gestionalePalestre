generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  SUBSCRIBER
}

enum SubscriptionTier {
  DAILY
  MONTHLY
  QUARTERLY
  YEARLY
  BIENNIAL
}

enum PaymentProvider {
  REVOLUT
  KLARNA
  STRIPE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum InstallmentPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELED
}

enum InstallmentStatus {
  SCHEDULED
  PAID
  FAILED
  REFUNDED
}

enum AccessEventType {
  ENTRY_SIMULATION
  DOOR_OPEN
  KEYPAD_UNLOCK
}

enum DocumentType {
  TAX_CODE
  IDENTITY_DOCUMENT
  MEDICAL_CERTIFICATE
  PROFILE_PHOTO
}

enum DocumentSide {
  FRONT
  BACK
  SINGLE
}

enum DocumentStatus {
  UPLOADED
  AI_PROCESSING
  NEEDS_REUPLOAD
  PENDING_ADMIN_REVIEW
  APPROVED
  REJECTED
}

enum DocumentJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  ESCALATED
}

/// Tipi di serie supportati nelle schede di allenamento. NORMAL e' il default;
/// gli altri rappresentano tecniche speciali (warmup, dropset, cluster, ecc.)
/// con semantica visiva diversa lato mobile.
enum WorkoutSetType {
  NORMAL
  WARMUP
  DROPSET
  CLUSTERSET
  REST_PAUSE
  AMRAP
  FAILURE
}

/// Visibilita' di una scheda. ASSIGNABLE = creata da admin/instructor per
/// essere assegnata ad altri utenti. PRIVATE = creata sul mobile da un
/// subscriber per uso personale (in pratica non finisce sul BE — ma teniamo
/// il valore in caso di feature future di backup).
enum WorkoutTemplateVisibility {
  PRIVATE
  ASSIGNABLE
}

model User {
  id                    String             @id @default(cuid())
  firstName             String
  lastName              String
  email                 String             @unique
  phoneNumber           String?
  address               String?
  passwordHash          String
  role                  UserRole           @default(SUBSCRIBER)
  accessCode            String             @db.VarChar(6)
  dateOfBirth           DateTime?
  assignedInstructorId  String?
  assignedInstructor    User?              @relation("InstructorAssignments", fields: [assignedInstructorId], references: [id], onDelete: SetNull)
  assignedSubscribers   User[]             @relation("InstructorAssignments")
  subscription          UserSubscription?
  workoutPlan           WorkoutPlan?
  accessEvents          AccessEvent[]
  documents             UserDocument[]     @relation("UserDocuments")
  uploadedDocuments     UserDocument[]     @relation("UserUploadedDocuments")
  reviewedDocuments     UserDocument[]     @relation("UserReviewedDocuments")
  documentJobs          DocumentProcessingJob[]
  sessions              Session[]
  accounts              Account[]
  subscriptionsAssigned UserSubscription[] @relation("AdminAssignedSubscriptions")
  payments              Payment[]
  installmentPlans      InstallmentPlan[]
  auditLogsAsTarget     UserAuditLog[]     @relation("UserAuditTargets")
  auditLogsAsActor      UserAuditLog[]     @relation("UserAuditActors")
  templatesCreated      WorkoutTemplate[]  @relation("WorkoutTemplatesCreated")
  workoutAssignmentsReceived WorkoutAssignment[] @relation("WorkoutAssignmentsReceived")
  workoutAssignmentsCreated  WorkoutAssignment[] @relation("WorkoutAssignmentsCreated")
  tuyaUserId            String?
  tuyaPinUnlockNo       String?
  tuyaPinActive         Boolean            @default(false)
  revolutCustomerId     String?
  passwordResetCodes    PasswordResetCode[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([role])
  @@index([assignedInstructorId])
}

model UserDocument {
  id                          String         @id @default(cuid())
  userId                      String
  type                        DocumentType
  side                        DocumentSide   @default(SINGLE)
  status                      DocumentStatus @default(UPLOADED)
  storageKey                  String
  fileName                    String
  fileLabel                   String
  mimeType                    String
  sizeBytes                   Int
  sha256                      String         @db.VarChar(64)
  uploadedById                String?
  uploadedAt                  DateTime       @default(now())
  aiAttempts                  Int            @default(0)
  aiConfidence                Float?
  aiLastError                 String?
  extractedTaxCode            String?        @db.VarChar(16)
  extractedIdentityNumber     String?        @db.VarChar(20)
  extractedDateOfBirth        DateTime?
  medicalCertificateExpiresAt DateTime?
  reviewedById                String?
  reviewedAt                  DateTime?
  rejectionReason             String?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  user                        User           @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy                  User?          @relation("UserUploadedDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy                  User?          @relation("UserReviewedDocuments", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, type, side])
  @@index([userId, type, status])
  @@index([status, uploadedAt(sort: Desc)])
  @@index([uploadedById])
  @@index([reviewedById])
}

model DocumentProcessingJob {
  id           String            @id @default(cuid())
  userId       String
  type         DocumentType
  status       DocumentJobStatus @default(QUEUED)
  attemptCount Int               @default(0)
  maxAttempts  Int               @default(3)
  nextRunAt    DateTime          @default(now())
  lastError    String?
  payload      Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt, createdAt])
  @@index([userId, type, status])
}

model UserSubscription {
  id            String           @id @default(cuid())
  userId        String           @unique
  tier          SubscriptionTier
  startsAt      DateTime
  endsAt        DateTime
  /// Se valorizzato, l'abbonamento e' considerato non attivo anche se endsAt
  /// e' futuro. Permette all'admin di sospendere/riattivare senza perdere lo
  /// storico di tier/date.
  deactivatedAt DateTime?
  assignedById  String?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy    User?            @relation("AdminAssignedSubscriptions", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([startsAt, endsAt])
  @@index([assignedById])
}

model WorkoutPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  monday    String?
  tuesday   String?
  wednesday String?
  thursday  String?
  friday    String?
  saturday  String?
  sunday    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccessEvent {
  id          String          @id @default(cuid())
  userId      String
  eventType   AccessEventType
  note        String?
  externalRef String?         @unique
  occurredAt  DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Payment {
  id                 String           @id @default(cuid())
  userId             String
  subscriptionId     String?
  provider           PaymentProvider
  providerReference  String
  amountCents        Int
  currency           String           @default("EUR") @db.VarChar(3)
  status             PaymentStatus    @default(PENDING)
  tier               SubscriptionTier
  paidAt             DateTime?
  failureReason      String?
  rawWebhookPayload  Json?
  installmentPlan    InstallmentPlan?
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([providerReference, provider])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model InstallmentPlan {
  id                     String                @id @default(cuid())
  paymentId              String                @unique
  userId                 String
  totalAmountCents       Int
  installmentsCount      Int
  installmentAmountCents Int
  klarnaOrderId          String?
  revolutSubscriptionId  String?
  firstChargeAt          DateTime
  status                 InstallmentPlanStatus @default(ACTIVE)
  payment                Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments           Installment[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([userId, status])
  @@index([status, firstChargeAt])
}

model Installment {
  id               String            @id @default(cuid())
  planId           String
  sequenceNumber   Int
  dueAt            DateTime
  amountCents      Int
  status           InstallmentStatus @default(SCHEDULED)
  paidAt           DateTime?
  klarnaCaptureId    String?
  providerReference  String?
  failureReason      String?
  plan             InstallmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([planId, sequenceNumber])
  @@index([status, dueAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Codice OTP a 6 cifre per il reset password (flusso "Password dimenticata"),
/// condiviso da web e mobile. Il codice non e' mai salvato in chiaro: si salva
/// l'hash bcrypt. Monouso (consumedAt), scadenza breve (expiresAt) e limite
/// tentativi (attempts) per resistere a brute force.
model PasswordResetCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

/// Audit log per tutte le azioni che un admin compie su un singolo iscritto.
/// Le entry sono append-only: niente update/delete, retention indefinita per
/// ora (lifecycle policy verra' aggiunta separatamente quando i volumi
/// crescono). Il payload Json contiene before/after per le mutazioni di
/// valore (es. { before: { role: "SUBSCRIBER" }, after: { role: "INSTRUCTOR" } }).
model UserAuditLog {
  id           String      @id @default(cuid())
  /// Utente "soggetto" dell'azione (chi ha subito la modifica). Nullable
  /// con SET NULL per preservare l'audit anche se l'utente viene eliminato.
  targetUserId String?
  /// Utente che ha eseguito l'azione (admin). Null se l'utente e' stato
  /// cancellato successivamente — manteniamo lo storico.
  actorId      String?
  /// Snapshot dell'identita' del target al momento dell'azione (utile dopo
  /// l'eliminazione, quando targetUserId diventa null).
  targetSnapshot Json?
  action       AuditAction
  payload      Json?
  createdAt    DateTime    @default(now())

  target User? @relation("UserAuditTargets", fields: [targetUserId], references: [id], onDelete: SetNull)
  actor  User? @relation("UserAuditActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

enum AuditAction {
  USER_CREATED
  USER_DELETED
  ROLE_CHANGED
  INSTRUCTOR_ASSIGNED
  INSTRUCTOR_UNASSIGNED
  ADDRESS_UPDATED
  SUBSCRIPTION_ASSIGNED
  SUBSCRIPTION_DEACTIVATED
  SUBSCRIPTION_REACTIVATED
  SUBSCRIPTION_DATE_CHANGED
  DOC_APPROVED
  DOC_REJECTED
  DOC_REUPLOAD_REQUESTED
  WORKOUT_TEMPLATE_ASSIGNED
  WORKOUT_TEMPLATE_UNASSIGNED
}

/// Catalogo centrale degli esercizi. Pre-popolato via seed con i piu' comuni
/// (panca piana, squat, ecc.) ed espandibile dagli admin/instructor durante
/// l'editing schede ("crea nuovo esercizio"). Lato mobile viene cacheato
/// localmente e usato per autocomplete.
model Exercise {
  id          String   @id @default(cuid())
  /// Nome canonico (case-insensitive unique a livello applicativo). Usato
  /// anche per il riferimento storico "ultima volta ho fatto..." nel log.
  name        String   @unique
  /// Gruppo muscolare primario (es. "Petto", "Schiena", "Gambe"). Opzionale.
  muscleGroup String?
  /// Attrezzatura richiesta (es. "Bilanciere", "Manubri", "Macchina"). Opzionale.
  equipment   String?
  /// Note libere (tecnica, video di riferimento). Opzionale.
  notes       String?
  /// Storage key R2 della foto dimostrativa dell'esercizio (impostata da
  /// admin/instructor durante l'editing schede). Null = nessuna foto. La URL
  /// presigned viene generata a richiesta lato API.
  photoStorageKey String?
  /// Esercizi creati ad-hoc dagli utenti (admin/instructor) compaiono come
  /// custom = true. Quelli del seed iniziale sono custom = false.
  isCustom    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templateExercises WorkoutTemplateExercise[]

  @@index([muscleGroup])
  @@index([isCustom])
}

/// Una scheda di allenamento. Creata da admin/instructor per essere
/// assegnata a uno o piu' iscritti. Cascade su sessions/exercises/sets.
model WorkoutTemplate {
  id           String                    @id @default(cuid())
  name         String
  description  String?
  /// Numero giorni/sedute settimanali (1-7). Validato lato applicazione.
  daysPerWeek  Int
  visibility   WorkoutTemplateVisibility @default(ASSIGNABLE)
  createdById  String
  createdBy    User                      @relation("WorkoutTemplatesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  sessions     WorkoutTemplateSession[]
  assignments  WorkoutAssignment[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([createdById])
  @@index([visibility])
}

/// Una seduta/giornata della scheda (es. "A - Push", "Lunedi'"). order definisce
/// l'ordine settimanale.
model WorkoutTemplateSession {
  id         String                    @id @default(cuid())
  templateId String
  template   WorkoutTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// 0-based, ordine di esecuzione settimanale.
  order      Int
  name       String
  exercises  WorkoutTemplateExercise[]

  @@unique([templateId, order])
  @@index([templateId])
}

/// Esercizio dentro una seduta. Riferisce il catalogo Exercise via FK ma
/// conserva anche `exerciseName` (snapshot) per leggibilita' anche dopo
/// rinomine/eliminazioni del catalogo.
model WorkoutTemplateExercise {
  id           String                 @id @default(cuid())
  sessionId    String
  session      WorkoutTemplateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise               @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  /// Snapshot del nome al momento della creazione/aggiornamento. Sopravvive
  /// a delete del catalogo Exercise.
  exerciseName String
  /// 0-based, ordine all'interno della seduta.
  order        Int
  notes        String?
  sets         WorkoutTemplateSet[]

  @@index([sessionId])
  @@index([exerciseId])
}

/// Singola serie prescritta per un esercizio. `reps` e' una stringa libera
/// per supportare range ("8-12") o tecniche speciali ("AMRAP"). `notes`
/// puo' descrivere la tecnica per DROPSET/CLUSTERSET (es. "−20% poi −20%"
/// o "3+3+3 con 15s pausa").
model WorkoutTemplateSet {
  id         String                  @id @default(cuid())
  exerciseId String
  exercise   WorkoutTemplateExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  /// 0-based, ordine all'interno dell'esercizio.
  order      Int
  type       WorkoutSetType          @default(NORMAL)
  reps       String
  /// Reps in reserve (RIR) opzionale.
  rir        Int?
  /// Recupero in secondi opzionale.
  rest       Int?
  notes      String?

  @@index([exerciseId])
}

/// Assegnazione di una scheda a un utente. Una scheda puo' essere
/// assegnata a piu' utenti (relazione N:N tramite questa tabella).
/// Idempotente: unique(templateId, userId).
model WorkoutAssignment {
  id           String          @id @default(cuid())
  templateId   String
  template     WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation("WorkoutAssignmentsReceived", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User            @relation("WorkoutAssignmentsCreated", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedAt   DateTime        @default(now())

  @@unique([templateId, userId])
  @@index([userId])
  @@index([templateId])
}
