DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST.neon.tech/DB_NAME?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/DB_NAME?sslmode=require"
AUTH_SECRET="replace-with-strong-random-secret"
AUTH_URL="http://localhost:3000"
SEED_ADMIN_EMAIL="umberto.giancola00@gmail.com"
SEED_ADMIN_PASSWORD="Castiglione1!"

# OpenAI document extraction
OPENAI_API_KEY="sk-..."
OPENAI_DOCS_MODEL="gpt-4.1-mini"
DOC_AI_MIN_CONFIDENCE="0.85"
DOC_AI_MAX_RETRIES="3"

# Cloudflare R2
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="gestionale-documents"
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"

# Upload/processing tuning
DOC_UPLOAD_MAX_BYTES="12582912"
DOC_PRESIGN_TTL_SECONDS="300"
DOC_JOB_BATCH_SIZE="10"
DOC_RATE_LIMIT_WINDOW_MS="60000"
DOC_RATE_LIMIT_MAX_REQUESTS="30"

# Cron protection
CRON_SECRET="replace-with-long-random-secret"

# Pagamenti — Revolut Merchant API
# La Secret key (`sk_...`) si genera dal Developer Portal Revolut (Merchant
# account, sotto-account del Business). NON serve certificato X509 / OAuth.
# La conferma pagamento avviene sia via webhook (`/api/webhooks/revolut`,
# signing secret `wsk_...`) sia via polling pull-side sulla success page.
# REVOLUT_BASE_URL opzionale: se assente, prod usa merchant.revolut.com e dev
# usa sandbox-merchant.revolut.com.
REVOLUT_SECRET_KEY="sk_..."
REVOLUT_WEBHOOK_SECRET=""
REVOLUT_API_VERSION="2024-09-01"
# REVOLUT_BASE_URL="https://sandbox-merchant.revolut.com"
# Variation id Revolut pre-create (Subscriptions) per i tier rateali:
REVOLUT_SUB_VARIATION_YEARLY=""
REVOLUT_SUB_VARIATION_BIENNIAL=""

# Pagamenti — Klarna (rate — feature flag off finché env vuote)
KLARNA_API_USER=""
KLARNA_API_PASSWORD=""
KLARNA_REGION="eu"
KLARNA_WEBHOOK_SECRET=""

# Base URL usato per costruire return_url / redirect provider
PAYMENT_RETURN_BASE_URL="http://localhost:3000"

# Email — Resend (usato per conferme pagamento e reminder compleanni)
RESEND_API_KEY=""
EMAIL_FROM="noreply@gestionalepalestre.it"

# Tuya IoT — Apertura porta palestra (Smart Home cloud project, Central Europe DC)
# Ottieni Client ID/Secret da iot.tuya.com -> Cloud -> tuo progetto -> Overview
# Device ID: Cloud -> Devices -> All Devices (dopo aver linkato l'app account)
TUYA_CLIENT_ID=""
TUYA_CLIENT_SECRET=""
TUYA_DEVICE_ID=""
TUYA_BASE_URL="https://openapi.tuyaeu.com"
# Payload base64 inviato al DP "remote_no_dp_key" per aprire la porta. Si cattura
# una sola volta dal device + portale Tuya developer (Cloud > Devices > Debug Device
# > Device Logs) intercettando l'azione "Apri" dell'app Tuya Smart. Il device non
# valida l'userId interno al payload, quindi resta stabile per quel keypad.
TUYA_REMOTE_OPEN_PAYLOAD=""
