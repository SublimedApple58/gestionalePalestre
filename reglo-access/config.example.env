# ─── reglo-access — configurazione servizio locale (PC palestra) ───
# Copia questo file in ".env" e compila i valori. NON committare ".env".

# --- Device Tuya (tastierino) ---
# DEVICE_ID e LOCAL_KEY si prendono dalla piattaforma Tuya IoT
# (Cloud > Devices > il device > "local key"). Vedi ONSITE-CHECKLIST.md.
DEVICE_ID=bf38d4d722d26342b0x6vp
LOCAL_KEY=
# IP locale del tastierino sulla rete della palestra (impostare IP fisso sul router).
DEVICE_IP=
# Versione protocollo locale Tuya: 3.3 / 3.4 / 3.5. La scopre 01_scan.py. Default 3.3.
PROTOCOL_VERSION=3.3

# --- Backend Reglo ---
# Base URL del backend (es. https://app.houseofmuscle.it). Senza slash finale.
BE_BASE_URL=
# Stesso CRON_SECRET configurato sul backend (Vercel env).
CRON_SECRET=

# --- Comportamento ---
# Ogni quanti secondi sincronizzare i codici dal backend al tastierino.
POLL_INTERVAL_SEC=300
# DP del relè/apertura (confermato in 03_open.py). Tipico: 40 o "remote_no_dp_key".
RELAY_DP=40
# Timeout connessione device (secondi).
DEVICE_TIMEOUT_SEC=8
# File di log (rotazione gestita dal servizio).
LOG_FILE=reglo-access.log
